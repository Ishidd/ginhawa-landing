SITE_URL=https://ginhawa-ph.vercel.app

# Public Firebase WEB app configuration, not an Admin SDK credential.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# STABLE approval only. Independent of Firestore OTA approval.
# Pin a tag-specific asset in Ishidd/ginhawa-landing; never /latest.
# Leave URL empty for coming soon. All three required when enabling downloads.
PUBLIC_APK_URL=
PUBLIC_APK_SHA256=
# Example format: 1.0.0 (9)
PUBLIC_APK_VERSION=
