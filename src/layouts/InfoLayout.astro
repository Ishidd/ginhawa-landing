---
import '../styles/cinematic.css';
import Footer from '../components/Footer.astro';
interface Props { title: string; description: string; sections?: {title: string; id: string}[]; updated?: string; }
const {title, description, sections = [], updated} = Astro.props;
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#05070D"/><title>{title} | ginhawa</title><link rel="icon" href="/assets/favicon.png"/><link rel="preload" href="/assets/BricolageGrotesque.ttf" as="font" type="font/ttf" crossorigin/></head>
<body><a class="skip-link" href="#main">Skip to content</a><header class="masthead"><a class="brand" href="/" aria-label="ginhawa home"><img src="/assets/favicon.png" width="32" height="32" alt=""/>ginhawa<span>.</span></a><a class="text-link" href="/">Back to ginhawa</a></header>
<main id="main" class:list={['info-page', 'wrap', {'has-contents': sections.length > 0}]}>
 {sections.length > 0 && <aside class="info-contents"><nav aria-label="On this page"><p>On this page</p>{sections.map(section => <a href={`#${section.id}`}>{section.title}</a>)}</nav></aside>}
 <article><h1>{title}</h1>{updated && <p class="document-updated">Updated {updated}</p>}{sections.length > 0 && <details class="mobile-doc-nav"><summary>On this page</summary><nav aria-label="Document sections">{sections.map(section => <a href={`#${section.id}`}>{section.title}</a>)}</nav></details>}<slot/></article>
</main><Footer /></body></html>
